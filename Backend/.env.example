# Server
PORT=8000
PREFIX=/api
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/taskforge

# Auth — use long random values, different for each secret.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-access-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-refresh-secret

# Object storage (matches the MinIO service in docker-compose.yml)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=taskforge-attachments
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Test database (used by `npm test`, must end in _test)
MONGO_URI_TEST=mongodb://127.0.0.1:27017/taskforge_test
