PORT=8000
MONGO_URI=mongodb://username:password@host:port/admin?replicaSet=setname
CLIENT_URL=http://localhost:5173
PREFIX=/api
JWT_SECRET=your_jwt_secret
REFRESH_TOKEN_SECRET=your_refresh_token_secret

# S3-compatible object storage (MinIO locally: docker compose up -d)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=taskforge-attachments
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
